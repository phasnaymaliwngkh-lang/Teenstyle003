###############################################################################
# TEENSTYLE AI — ตัวอย่าง Environment Variables
#
# วิธีใช้:
#   1. คัดลอกไฟล์นี้เป็น .env            (สำหรับ backend / database / docker compose)
#   2. คัดลอก frontend/.env.local.example เป็น frontend/.env.local
#   3. เติมค่าจริงของคุณเอง
#
# ห้าม commit ไฟล์ .env หรือ .env.local (อยู่ใน .gitignore แล้ว)
# ห้ามใส่ secret จริงลงในไฟล์ .example นี้
###############################################################################

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Bangkok

# Port ของแต่ละ service
BACKEND_PORT=4000
FRONTEND_PORT=3000

# PORT — อย่าตั้งเองตอน dev
# โฮสต์อย่าง Railway / Render / Fly.io / Cloud Run จะฉีดค่านี้มาให้ตอน deploy
# และโค้ดให้ PORT ชนะ BACKEND_PORT เสมอ (ไม่งั้น health check ของโฮสต์จะล้ม)
# PORT=

# URL ที่ service ใช้เรียกกัน
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Origin ที่อนุญาตให้เรียก API (คั่นด้วย comma ถ้ามีหลายค่า)
CORS_ORIGIN=http://localhost:3000

# ─── Database: PostgreSQL ────────────────────────────────────────────────────
# รูปแบบ: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# กรณีใช้ docker compose (ค่าด้านล่างตรงกับ docker-compose.yml):
#   DATABASE_URL=postgresql://teenstyle:teenstyle_dev_password@localhost:5432/teenstyle?schema=public
#
# กรณีใช้ PostgreSQL ที่ติดตั้งในเครื่องเอง:
#   DATABASE_URL=postgresql://postgres:<รหัสผ่านของคุณ>@localhost:5432/teenstyle?schema=public
#   ถ้ารหัสมีอักขระพิเศษต้อง percent-encode (@ → %40, # → %23, / → %2F)
#   ไม่ต้องสร้าง database เอง — Prisma สร้างให้ตอน migrate
#
# dev ใช้ผู้ใช้ postgres ได้ แต่ production ต้องใช้ role ที่มีสิทธิ์เท่าที่จำเป็น
POSTGRES_USER=teenstyle
POSTGRES_PASSWORD=teenstyle_dev_password
POSTGRES_DB=teenstyle
POSTGRES_PORT=5432
DATABASE_URL=postgresql://teenstyle:teenstyle_dev_password@localhost:5432/teenstyle?schema=public

# อีเมล Google ที่จะได้สิทธิ์ SUPER_ADMIN ตอน seed (เว้นว่างได้ — จะข้ามการสร้าง admin)
SEED_ADMIN_EMAIL=

# ─── Cache / Queue: Redis ────────────────────────────────────────────────────
# ใช้จริงใน STEP 34 (cache) และ STEP 52 (BullMQ background jobs)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Authentication: Auth.js (NextAuth) + Google OAuth ───────────────────────
# ใช้จริงใน STEP 3 — ดูวิธีขอ credential ที่ docs/04-google-oauth-setup.md
# สร้าง AUTH_SECRET ด้วย: npx auth secret   (หรือ openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT ที่ backend ใช้ตรวจ session จาก frontend (STEP 3)
BACKEND_JWT_SECRET=

# ─── AI: OpenAI ──────────────────────────────────────────────────────────────
# ใช้จริงใน STEP 19-21, 45-46 — เรียกจาก backend เท่านั้น ห้ามส่งไป frontend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Image Storage: Cloudinary ───────────────────────────────────────────────
# ใช้จริงใน STEP 47
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Payment ─────────────────────────────────────────────────────────────────
# ใช้จริงใน STEP 11 — ห้ามเก็บ raw card data ในระบบเราเอง
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PROMPTPAY_ID=

# ─── Email (STEP 24) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TEENSTYLE AI <no-reply@teenstyle.local>"

# ─── Rate limiting (STEP 28) ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ─── Logging / Monitoring (STEP 51) ──────────────────────────────────────────
LOG_LEVEL=info
