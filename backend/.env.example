# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example
#
# ปกติ "ไม่ต้อง" สร้างไฟล์นี้ — backend อ่าน .env จาก root ของ repo ให้อยู่แล้ว
# สร้าง backend/.env เฉพาะเมื่อต้องการ override ค่าเฉพาะ backend ในเครื่องตัวเอง
# (ลำดับความสำคัญ: process.env > backend/.env > <repo root>/.env)
#
# รายการ env ทั้งหมดของระบบดูที่ ../.env.example
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ต้องมีตั้งแต่ STEP 2 ขึ้นไป
DATABASE_URL=

# ใช้จริงตั้งแต่ STEP 34 / 52
REDIS_URL=

LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
