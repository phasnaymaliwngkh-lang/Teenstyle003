# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.local.example
#
# คัดลอกเป็น frontend/.env.local
#
# ⚠️ ไฟล์นี้ควรมี **เฉพาะตัวแปร NEXT_PUBLIC_*** เท่านั้น
#
#    secret ของฝั่ง server (AUTH_SECRET, GOOGLE_CLIENT_*, DATABASE_URL, OPENAI_API_KEY ...)
#    อยู่ในไฟล์ .env ที่ root ของโปรเจกต์ ซึ่ง frontend/next.config.ts โหลดเข้ามาให้แล้ว
#
#    เหตุผลที่ห้ามประกาศซ้ำที่นี่:
#      Next โหลด .env.local **ทีหลัง** ค่าจาก root จึงถูกเขียนทับ
#      ถ้าประกาศไว้แบบว่าง (เช่น AUTH_SECRET=) จะกลายเป็นค่าว่างทับค่าจริง
#      แล้ว Auth.js จะขึ้น error MissingSecret ทั้งที่ root .env มีค่าอยู่
#
#    ถ้าต้องการ override เฉพาะเครื่องตัวเอง ให้ใส่ค่าจริงลงไป (ไม่ใช่ปล่อยว่าง)
#
# ⚠️ ค่า NEXT_PUBLIC_* ถูกฝังลง JavaScript ที่ส่งไปเบราว์เซอร์ — ห้ามใส่ secret
# ─────────────────────────────────────────────────────────────────────────────

# URL ของ REST API แบบเต็ม — ฝั่ง server ใช้ค่านี้เรียก backend ตรง ๆ
# (และเป็นปลายทางของ rewrite เมื่อเปิดใช้ NEXT_PUBLIC_API_PROXY_PATH)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ จำเป็นตอน deploy production: prefix ที่เบราว์เซอร์ใช้เรียก backend
#    ผ่านโดเมนของ frontend
#
# ถ้าเบราว์เซอร์ยิงไป backend คนละโดเมนตรง ๆ Chrome/Safari จะบล็อก cookie
# แบบ third-party → ตะกร้า สั่งซื้อ จ่ายเงิน และการแก้ข้อมูลหลังบ้านพังทั้งหมด
# (ตอน dev ไม่พังเพราะ cookie ไม่แยกตาม port จึงต้องจำไว้ว่าปัญหานี้โผล่แค่บน production)
#
# ตั้งค่านี้แล้ว Next จะ rewrite <prefix>/* ไปที่ NEXT_PUBLIC_API_URL ให้เอง
# ห้ามใช้ `/api` เพราะ Next เป็นเจ้าของ /api/auth/* และ /api/cart/merge อยู่แล้ว
#
# dev บนเครื่องเดียว: เว้นว่างไว้ (ยิงตรงไป :4000 เหมือนเดิม)
# production: NEXT_PUBLIC_API_PROXY_PATH=/backend
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_PROXY_PATH=

# ชื่อร้านที่แสดงบนหน้าเว็บ (STEP 49 จะย้ายไปดึงจาก Store Settings ใน database)
NEXT_PUBLIC_SITE_NAME=TeenStyle

# ─────────────────────────────────────────────────────────────────────────────
# โดเมนจริงของเว็บ — ตอน production **ต้องเปลี่ยนเป็นโดเมนจริง** (STEP 33)
#
# ค่านี้ถูกใช้เป็นฐานของ canonical URL, sitemap.xml, robots.txt และ og:image
# ถ้าปล่อยเป็น localhost ตอน deploy Google จะได้รับ canonical ที่ชี้ไป localhost
# ซึ่งแปลว่า "หน้าจริงอยู่ที่เครื่องนั้น" → ทั้งเว็บหายจากผลการค้นหา
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
