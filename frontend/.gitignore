# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...แต่ไฟล์ตัวอย่างต้องขึ้น repo ไม่งั้นคนที่ clone ไปจะไม่รู้ว่าต้องตั้ง env อะไร
# (.gitignore ในโฟลเดอร์นี้ทับกฎ !*.example ของ root จึงต้องยกเว้นซ้ำที่นี่)
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
