{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",

    /* type ของ @teenstyle/database ชี้ไปที่ TypeScript source ซึ่ง import
       generated client ของ Prisma 7 ด้วยนามสกุล .ts
       เปิดได้โดยไม่ต้องมี rewriteRelativeImportExtensions เพราะ frontend เป็น noEmit
       (ตอน runtime Next โหลด @teenstyle/database เป็น Node module จาก dist ผ่าน
        serverExternalPackages จึงไม่มี .ts เข้ามาเกี่ยวข้อง) */
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
